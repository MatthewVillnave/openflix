# Used by the server from the repository root; never put secrets in VITE_*.
NODE_ENV=development
OPENFLIX_BASE_URL=http://localhost:5173
OPENFLIX_HOST=127.0.0.1
OPENFLIX_PORT=8787
OPENFLIX_DATA_DIR=.data
OPENFLIX_LOG_LEVEL=info
OPENFLIX_SESSION_TTL_SECONDS=86400

# Optional until a connector is saved. Supply 32 random bytes as canonical base64.
# Keep this key outside source control and separate from database backups.
# OPENFLIX_MASTER_KEY=
